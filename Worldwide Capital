<!DOCTYPE html>
<html>
<head>
  <title>WORLD WIDE CAPITAL</title>

  <style>
    body {
      margin: 0;
      font-family: Arial;
      background: #2b2b2b;
      color: white;
    }

    header {
      background: gold;
      color: black;
      text-align: center;
      padding: 25px;
      font-size: 30px;
      font-weight: bold;
    }

    .container {
      padding: 20px;
      text-align: center;
    }

    .box {
      background: #3a3a3a;
      padding: 20px;
      margin: 15px auto;
      width: 85%;
      border-radius: 10px;
      border: 1px solid gold;
    }

    input, textarea {
      width: 90%;
      padding: 10px;
      margin: 8px 0;
      border-radius: 5px;
      border: none;
    }

    button {
      background: gold;
      border: none;
      padding: 12px;
      cursor: pointer;
      font-size: 16px;
      border-radius: 5px;
      margin-top: 10px;
    }

    .whatsapp {
      display: inline-block;
      background: #25D366;
      color: white;
      padding: 12px 18px;
      text-decoration: none;
      border-radius: 5px;
      font-weight: bold;
      margin-top: 10px;
    }

    footer {
      background: black;
      text-align: center;
      padding: 15px;
      margin-top: 30px;
    }
  </style>
</head>

<body>

<header>
  🌍 WORLD WIDE CAPITAL
</header>

<div class="container">

  <div class="box">
    <h2>Logbook Loans</h2>
    <p>Fast and reliable vehicle loan services.</p>
  </div>

  <!-- LOAN FORM -->
  <div class="box">
    <h2>Loan Application Form</h2>

    <form id="loanForm">

      <input type="text" id="name" placeholder="Full Name" required>

      <input type="tel" id="phone" placeholder="Phone Number" required>

      <input type="email" id="email" placeholder="Email Address" required>

      <input type="text" id="id" placeholder="National ID Number" required>

      <input type="text" id="vehicle" placeholder="Vehicle Make & Model" required>

      <input type="number" id="amount" placeholder="Loan Amount Required" required>

      <textarea id="message" placeholder="Additional Information"></textarea>

      <button type="submit">Submit Application</button>

    </form>
  </div>

  <div class="box">
    <h2>Contact Us</h2>

    <p>📞 0798251509</p>
    <p>📧 worldwidecapital254@gmail.com</p>

    <a class="whatsapp" href="https://wa.me/254798251509" target="_blank">
      💬 Chat on WhatsApp
    </a>
  </div>

</div>

<footer>
  © 2026 WORLD WIDE CAPITAL
</footer>

<!-- FORM SCRIPT -->
<script>
document.getElementById("loanForm").addEventListener("submit", function(e) {
  e.preventDefault();

  let name = document.getElementById("name").value;
  let phone = document.getElementById("phone").value;
  let email = document.getElementById("email").value;
  let id = document.getElementById("id").value;
  let vehicle = document.getElementById("vehicle").value;
  let amount = document.getElementById("amount").value;
  let message = document.getElementById("message").value;

  let text =
`NEW LOAN APPLICATION
----------------------
Name: ${name}
Phone: ${phone}
Email: ${email}
ID: ${id}
Vehicle: ${vehicle}
Amount: ${amount}
Message: ${message}`;

  let whatsappURL = "https://wa.me/254798251509?text=" + encodeURIComponent(text);

  window.open(whatsappURL, "_blank");
});
</script>

</body>
</html>
